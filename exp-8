
import cv2
import numpy as np
import os

# Get the folder path
folder = os.path.dirname(os.path.abspath(__file__))

# Read the image
image_path = os.path.join(folder, "input.jpg")
image = cv2.imread(image_path)

if image is None:
    print("Error: Image not found!")
else:
    # Create a kernel
    kernel = np.ones((15, 15), np.uint8)

    # Apply dilation
    dilated = cv2.dilate(image, kernel, iterations=2)

    # Display images
    cv2.imshow("Original Image", image)
    cv2.imshow("Dilated Image", dilated)

    # Save the output image
    output_path = os.path.join(folder, "dilated_image.jpg")
    cv2.imwrite(output_path, dilated)

    print("Dilation completed successfully!")
    print("Output saved as dilated_image.jpg")

    cv2.waitKey(0)
    cv2.destroyAllWindows()

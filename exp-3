
import cv2
import os

# Read image from the same folder as this program
folder = os.path.dirname(os.path.abspath(__file__))
image_path = os.path.join(folder, "input.jpg")

image = cv2.imread(image_path)

if image is None:
    print("Error: Image not found!")
else:
    # Convert to grayscale
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

    # Detect image outlines
    edges = cv2.Canny(gray, 100, 200)

    # Save the output
    output_path = os.path.join(folder, "canny_output.jpg")
    cv2.imwrite(output_path, edges)

    print("Canny Edge Detection completed!")
    print("Saved at:", output_path)

    # Display images
    cv2.imshow("Original Image", image)
    cv2.imshow("Canny Edge Output", edges)

    cv2.waitKey(0)
    cv2.destroyAllWindows()


import cv2
import os
import matplotlib.pyplot as plt

def analyze_histogram(image_path):
    # Read the input image
    image = cv2.imread(image_path)

    if image is None:
        print("Error: Image not found!")
        return

    # Define colors and their histogram colors
    colors = ('b', 'g', 'r')
    channel_names = ('Blue', 'Green', 'Red')

    # Analyze each color channel
    for i, color in enumerate(colors):
        histogram = cv2.calcHist(
            [image], [i], None, [256], [0, 256]
        )

        plt.plot(histogram, color=color, label=channel_names[i])

    # Display the histogram
    plt.title("Color Histogram Analysis")
    plt.xlabel("Pixel Intensity (0-255)")
    plt.ylabel("Number of Pixels")
    plt.xlim([0, 256])
    plt.legend()
    plt.grid()
    plt.show()

    # Display the original image
    cv2.imshow("Input Image", image)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

    print("Color histogram analysis completed!")

# Call the function
folder = os.path.dirname(os.path.abspath(__file__))
image_path = os.path.join(folder, "input.jpg")
analyze_histogram(image_path)
